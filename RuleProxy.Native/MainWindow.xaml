<Window x:Class="RuleProxy.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RuleProxy — 分应用 / 分端口代理"
        Height="800" Width="1180" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9"
        Foreground="#20242B">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#20242B"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#68707D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E1E4E8"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#F7F8FA"/>

        <!-- 按钮：更紧凑的 34px 高度，字体 13px 常规 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- 输入框：34px 高度，13px 文字，居中 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#D7DBE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#D7DBE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 标签页：13px 常规，选中加粗 + 蓝色下划线 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#F7F8FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表格：36px 行高，13px 内容，12px 表头 -->
        <Style TargetType="DataGrid">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F2"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="#E8EAED"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF1FF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 字段标签：12px，灰色，用于编辑区表头 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- 表格单元格文字：左右留白 18px，垂直居中，不折行 -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态与操作 -->
        <Border Grid.Row="0" Background="Transparent" Padding="2,0,2,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="RuleProxy" FontSize="20" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="1,4,0,0">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#9CA3AF" Margin="0,4,6,0"/>
                        <TextBlock x:Name="StatusText" Text="代理未启动" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleProxyButton" Style="{StaticResource PrimaryButton}" Click="OnToggleProxy" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToggleProxyIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ToggleProxyText" Text="启动代理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SysProxyButton" Content="设置系统代理" Click="OnToggleSystemProxy"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 标签页 -->
        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="连接">
                <DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0" CanUserAddRows="False" SelectionMode="Single"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="72" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="目标" Binding="{Binding Destination}" Width="220" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="规则" Binding="{Binding RuleName}" Width="170" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="动作" Binding="{Binding ActionText}" Width="90" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="上行" Binding="{Binding UpBytes}" Width="95" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="下行" Binding="{Binding DownBytes}" Width="95" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="规则">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="OnRuleSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="匹配类型" Binding="{Binding MatchTypeText}" Width="120" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="匹配值" Binding="{Binding MatchValue}" Width="2.5*" MinWidth="220" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="1.5*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="启用" Width="70" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  Focusable="False"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Click="OnRuleEnabledClicked"
                                                  ToolTip="单击立即启用/停用并保存"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="White"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="RuleNameBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="匹配类型" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="RuleTypeBox" SelectionChanged="OnRuleTypeChanged">
                                    <ComboBoxItem Content="目标端口" Tag="dest_port"/>
                                    <ComboBoxItem Content="目标主机/域名" Tag="dest_host"/>
                                    <ComboBoxItem Content="应用进程" Tag="process"/>
                                    <ComboBoxItem Content="客户端源端口" Tag="src_port"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="代理方式" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="RuleActionProxyBox"
                                          ToolTip="选择直连、阻止，或一个上游代理"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="备注" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="RuleNoteBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="状态" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <Border Height="34" Background="White" BorderBrush="#D7DBE0" BorderThickness="1"
                                        CornerRadius="5" Padding="10,0">
                                    <CheckBox x:Name="RuleEnabledBox" Content="启用" IsChecked="True"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="匹配值" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="RuleValueBox" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="BrowseFileButton" Content="文件" MinWidth="0"
                                                        Padding="8,0" Click="OnBrowseFile" Margin="6,0,0,0"/>
                                                <Button x:Name="BrowseFolderButton" Content="文件夹" MinWidth="0"
                                                        Padding="8,0" Click="OnBrowseFolder" Margin="6,0,0,0"/>
                                                <Button Content="上移" MinWidth="0" Padding="8,0"
                                                        Click="OnMoveRuleUp" Margin="10,0,0,0"/>
                                                <Button Content="下移" MinWidth="0" Padding="8,0"
                                                        Click="OnMoveRuleDown" Margin="6,0,0,0"/>
                                                <Button Content="删除" MinWidth="0" Padding="8,0"
                                                        Click="OnDeleteRule" Margin="6,0,0,0"/>
                                                 <Button Content="保存修改" MinWidth="0" Padding="10,0"
                                                     Click="OnSaveRule" Margin="6,0,0,0"/>
                                                <Button x:Name="AddRuleButton" Content="添加规则" MinWidth="0" Padding="10,0"
                                                        Style="{StaticResource PrimaryButton}" Click="OnAddRule"
                                                        Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="上游代理">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="UpstreamsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="OnUpstreamSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="140" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="主机" Binding="{Binding Host}" Width="160" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="120" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="启用" Width="60" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  Focusable="False"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Click="OnUpstreamEnabledClicked"
                                                  ToolTip="单击立即启用/停用并保存"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="{StaticResource SubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="0.75*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <TextBox x:Name="UpNameBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="类型" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="UpTypeBox">
                                    <ComboBoxItem Content="HTTP" Tag="http"/>
                                    <ComboBoxItem Content="SOCKS5" Tag="socks5"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="主机" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <TextBox x:Name="UpHostBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,12,0">
                                <TextBlock Text="端口" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <TextBox x:Name="UpPortBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,12,0">
                                <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <TextBox x:Name="UpUserBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="5" Margin="0,0,12,0">
                                <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <TextBox x:Name="UpPassBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="6">
                                <TextBlock Text="状态" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <Border Height="36" Background="White" BorderBrush="#D7DBE0" BorderThickness="1"
                                        CornerRadius="5" Padding="12,0">
                                    <CheckBox x:Name="UpEnabledBox" Content="启用" IsChecked="True"/>
                                </Border>
                            </StackPanel>

                            <Border Grid.Row="2" Grid.ColumnSpan="7" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="删除" Click="OnDeleteUpstream" Margin="0,0,8,0"/>
                                     <Button Content="保存修改" Click="OnSaveUpstream" Margin="0,0,8,0"/>
                                    <Button x:Name="AddUpButton" Content="添加上游" Style="{StaticResource PrimaryButton}"
                                            Click="OnAddUpstream"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="日志">
                <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" RowHeaderWidth="0" CanUserAddRows="False"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="设置">
                <Grid Margin="12" MaxWidth="820" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="常规设置" Style="{StaticResource SectionTitle}" Margin="2,2,0,14"/>

                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="启动后开启代理" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="程序启动后自动开始本地代理服务" FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,4,16,0"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoStartProxyCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开机静默启动" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="开机自启动时不显示主窗口，直接在系统托盘后台运行" FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,4,16,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="StartMinimizedCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="恢复上次状态" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="恢复退出时的代理和系统代理状态；启用后优先于自动开启代理"
                                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,16,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="RememberLastStateCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开机自启动" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="AutostartPathText" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,16,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutostartCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                              Click="OnAutostartCheckChanged"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="软件更新" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="CurrentVersionText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,16,0"/>
                                    </StackPanel>
                                    <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="检查更新" Click="OnCheckUpdates" Margin="0,0,14,0"/>
                                    <CheckBox x:Name="CheckUpdatesCheckBox" Grid.Column="2" Content="启动时检查更新" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,16,0,0" Padding="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource PrimaryButton}"
                                    Click="OnSaveSettings" Margin="0,0,8,0"/>
                            <Button Content="导出配置" Click="OnSaveConfigFile"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部统计 -->
        <Border Grid.Row="2" Background="Transparent" Padding="2,10,2,0">
            <TextBlock x:Name="StatsText" Text="连接 0 · 累计上行 0 B · 累计下行 0 B"
                   FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
        </Border>
    </Grid>
</Window>
